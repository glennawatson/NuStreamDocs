<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PackageId>NuStreamDocs.Theme.Material</PackageId>
    <Description>Material-styled theme for NuStreamDocs. Page template, styles, and scripts all ship inside the package — no external assets to manage.</Description>
    <RootNamespace>NuStreamDocs.Theme.Material</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NuStreamDocs\NuStreamDocs.csproj"/>
    <ProjectReference Include="..\NuStreamDocs.Theme.Common\NuStreamDocs.Theme.Common.csproj"/>
    <ProjectReference Include="..\NuStreamDocs.Templating\NuStreamDocs.Templating.csproj"/>
    <ProjectReference Include="..\NuStreamDocs.Fonts\NuStreamDocs.Fonts.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NuStreamDocs.Theme.Material.Tests"/>
  </ItemGroup>

</Project>
