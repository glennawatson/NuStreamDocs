<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PackageId>NuStreamDocs.Mermaid</PackageId>
    <Description>Render Mermaid diagrams (flowcharts, sequence diagrams, class diagrams, …) from fenced ```mermaid blocks in your NuStreamDocs documentation.</Description>
    <RootNamespace>NuStreamDocs.Mermaid</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NuStreamDocs\NuStreamDocs.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NuStreamDocs.Mermaid.Tests"/>
  </ItemGroup>

</Project>
