<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <RoslynCommonAnalyzersVersion>5.2.0</RoslynCommonAnalyzersVersion>
    <SourceDocParserVersion>2.8.0</SourceDocParserVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="StyleSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="SecuritySharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="ICSharpCode.Decompiler" Version="11.2.0.10050" />
  </ItemGroup>

  <ItemGroup>
    <!-- Published from glennawatson/SourceDocParserLib. Keep aligned
         with rxui/website to avoid catalog-format drift between the
         two consumers. -->
    <PackageVersion Include="SourceDocParser" Version="$(SourceDocParserVersion)" />
    <PackageVersion Include="SourceDocParser.NuGet" Version="$(SourceDocParserVersion)" />
    <PackageVersion Include="SourceDocParser.Zensical" Version="$(SourceDocParserVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Thin P/Invoke SQLite layer for NuStreamDocs.Search.Sqlite. bundle_e_sqlite3
         pulls the per-RID e_sqlite3 native (compiled with SQLITE_ENABLE_FTS5). -->
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="Polly" Version="8.9.1" />
    <PackageVersion Include="Polly.RateLimiting" Version="8.9.1" />
  </ItemGroup>

  <Choose>
    <When Condition="'$(TargetFramework)' != '' And $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
      <ItemGroup>
        <PackageVersion Include="Microsoft.Build.Tasks.Git" Version="11.0.100" />
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
        <PackageVersion Include="System.Threading.RateLimiting" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="11.0.0" />
        <PackageVersion Include="System.IO.Hashing" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageVersion Include="Microsoft.Build.Tasks.Git" Version="10.0.404" />
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.404" />
        <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.15" />
        <PackageVersion Include="System.IO.Hashing" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
      </ItemGroup>
    </Otherwise>
  </Choose>
</Project>
