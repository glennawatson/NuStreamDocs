<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PackageId>NuStreamDocs.Images</PackageId>
    <Description>Pure managed UTF-8 and binary image pipeline that reads intrinsic PNG, JPEG, GIF, WebP, AVIF, and SVG dimensions at build time, injects missing width, height, loading="lazy", and decoding="async" attributes to eliminate layout shift, and optionally wraps titled images in accessible figure/figcaption markup.</Description>
    <RootNamespace>NuStreamDocs.Images</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NuStreamDocs\NuStreamDocs.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NuStreamDocs.Images.Tests"/>
  </ItemGroup>

</Project>
