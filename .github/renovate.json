{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:dotnetMonorepo",
    "group:nugetMonorepo",
    "security:openssf-scorecard"
  ],
  "mode": "full",
  "timezone": "Australia/Melbourne",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "labels": ["dependencies"],
  "recreateWhen": "auto",
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "commitMessageAction": "bump",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^SourceDocParser(\\.|$)/"],
      "groupName": "SourceDocParser"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^Microsoft\\.CodeAnalysis(\\.|$)/"],
      "groupName": "Roslyn"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^TUnit(\\.|$)/", "/^Microsoft\\.Testing\\./", "Microsoft.Extensions.TimeProvider.Testing"],
      "groupName": "test runner"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^StyleSharp\\./", "/^PerformanceSharp\\./", "/^SecuritySharp\\./"],
      "groupName": "analyzers",
      "labels": ["dependencies", "build-gate"]
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^Polly(\\.|$)/"],
      "groupName": "Polly"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^SQLitePCLRaw\\./"],
      "groupName": "SQLite"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["BenchmarkDotNet", "Microsoft.Diagnostics.Tracing.TraceEvent"],
      "groupName": "performance tooling"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["BenchmarkDotNet"],
      "ignoreUnstable": false
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["MinVer"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "GitHub Actions digests"
    },
    {
      "description": "Keep .NET 10 package entries on 10.x.",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "/^Microsoft\\.Extensions\\./",
        "/^Microsoft\\.AspNetCore\\./",
        "/^Microsoft\\.NETCore\\./",
        "/^Microsoft\\.SourceLink\\./",
        "Microsoft.Build.Tasks.Git",
        "/^System\\./"
      ],
      "matchCurrentValue": "/^10\\./",
      "allowedVersions": "/^10\\./",
      "ignoreUnstable": true,
      "groupName": ".NET 10 packages",
      "groupSlug": "dotnet-10"
    },
    {
      "description": "Keep .NET 11 package entries on 11.x.",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "/^Microsoft\\.Extensions\\./",
        "/^Microsoft\\.AspNetCore\\./",
        "/^Microsoft\\.NETCore\\./",
        "/^Microsoft\\.SourceLink\\./",
        "Microsoft.Build.Tasks.Git",
        "/^System\\./"
      ],
      "matchCurrentValue": "/^11\\./",
      "allowedVersions": "/^11\\./",
      "ignoreUnstable": false,
      "groupName": ".NET 11 packages",
      "groupSlug": "dotnet-11"
    },
    {
      "description": "The shared actions are pinned to a main commit; one PR moves every reference.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["glennawatson/actions-common"],
      "groupName": "shared GitHub Actions"
    }
  ],
  "customManagers": [
    {
      "description": "Packages a file-based app pins inline with #:package Name@Version. Versionless #:package lines take their version from Directory.Packages.props, which the nuget manager already reads.",
      "customType": "regex",
      "managerFilePatterns": ["/\\.cs$/"],
      "matchStrings": ["(?m)^#:package\\s+(?<depName>[^@\\s]+)@(?<currentValue>\\S+)"],
      "datasourceTemplate": "nuget"
    },
    {
      "description": "MSBuild SDKs a file-based app pins inline with #:sdk Name@Version.",
      "customType": "regex",
      "managerFilePatterns": ["/\\.cs$/"],
      "matchStrings": ["(?m)^#:sdk\\s+(?<depName>[^@\\s]+)@(?<currentValue>\\S+)"],
      "datasourceTemplate": "nuget",
      "depTypeTemplate": "msbuild-sdk"
    }
  ]
}
